{
  "name": "blockprint",
  "version": "0.2.1",
  "description": "Typed, config-driven block renderer for React. Render arbitrary UI trees from untrusted JSON with compile-time registry safety and runtime schema validation.",
  "license": "MIT",
  "homepage": "https://blockprint.terzidest.com",
  "bugs": {
    "url": "https://github.com/terzidest/blockprint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terzidest/blockprint.git",
    "directory": "packages/blockprint"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "import": "./dist/config.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "node scripts/ensure-pnpm.mjs && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": [
    "react",
    "cms",
    "renderer",
    "blocks",
    "page-builder",
    "typescript",
    "standard-schema"
  ],
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
